#!/sbin/sh
# MultiRoot recovery bootstrap (POSIX sh, recovery compatible)
# Args from recovery: $1 api-version, $2 fd, $3 zipfile
# Picks InstallMultiRoot.sh (default) or UninstallMultiRoot.sh (*uninstall*).
# Logs to /tmp/multiroot_debug.log so the user can inspect in recovery terminal.
OUTFD="$2"
ZIPFILE="$3"
TMPDIR="/dev/tmp"
BBBIN="$TMPDIR/busybox"
INSTALLER="$TMPDIR/multiroot"

DBG=""
for d in /tmp /dev/tmp /cache/recovery /data/local/tmp; do
  if [ -d "$d" ] || mkdir -p "$d" 2>/dev/null; then DBG="$d/multiroot_debug.log"; break; fi
done
if [ -z "$DBG" ]; then DBG="/tmp/multiroot_debug.log"; fi

raw_print() {
  echo "$1" >> "$DBG" 2>/dev/null
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\nui_print\n' "$1" >> "/proc/self/fd/$OUTFD" 2>/dev/null
  else
    echo "$1" >&2
  fi
}

raw_print "****************************"
raw_print " MultiRoot Recovery ZIP"
raw_print " v2.1 (KP-0.13.8 + Magisk-30.6)"
raw_print " Universal Root for Android"
raw_print "****************************"

# Normalize TMPDIR to somewhere writable.
TMPDIR=""
for d in /tmp /dev/tmp /cache/recovery /data/local/tmp; do
  if mkdir -p "$d" 2>/dev/null && [ -d "$d" ]; then TMPDIR="$d"; break; fi
done
if [ -z "$TMPDIR" ]; then TMPDIR="/tmp"; mkdir -p "$TMPDIR" 2>/dev/null; fi
if [ -z "$DBG" ] || [ ! -d "$(dirname "$DBG" 2>/dev/null)" ]; then DBG="$TMPDIR/multiroot_debug.log"; fi
: > "$DBG" 2>/dev/null

BBBIN="$TMPDIR/busybox"
INSTALLER="$TMPDIR/multiroot"
rm -rf "$INSTALLER" 2>/dev/null
if [ -f "$BBBIN" ]; then : > "$BBBIN" 2>/dev/null; rm -f "$BBBIN" 2>/dev/null; fi
mkdir -p "$INSTALLER" 2>/dev/null

# Normalize ZIPFILE argument; some recoveries or sideload flows pass arguments differently
if [ -z "$ZIPFILE" ] || [ ! -f "$ZIPFILE" ]; then
  for cand in "$3" "$2" "$1" /sideload/package.zip /tmp/update.zip /sdcard/update.zip /dev/tmp/package.zip; do
    if [ -n "$cand" ] && [ -f "$cand" ]; then ZIPFILE="$cand"; break; fi
  done
fi

if [ ! -f "$ZIPFILE" ]; then
  raw_print "- Zip not found: $ZIPFILE"
  raw_print "- tip: re-download, sdcard may be unmounted"
  exit 1
fi


# Busybox bootstrap with multi-arch detection (arm64, arm 32-bit, x86_64, x86)
raw_print "- Extracting busybox ..."
ARCH=""
unzip -o "$ZIPFILE" "busybox" -d "$TMPDIR" >> "$DBG" 2>&1
if [ -f "$TMPDIR/busybox" ]; then
  chmod 755 "$TMPDIR/busybox" 2>/dev/null
  if "$TMPDIR/busybox" true >> "$DBG" 2>&1; then
    mv -f "$TMPDIR/busybox" "$BBBIN" 2>/dev/null
    ARCH="arm64-v8a"
  fi
fi

if [ ! -x "$BBBIN" ]; then
  unzip -o "$ZIPFILE" "busybox32" -d "$TMPDIR" >> "$DBG" 2>&1
  if [ -f "$TMPDIR/busybox32" ]; then
    chmod 755 "$TMPDIR/busybox32" 2>/dev/null
    if "$TMPDIR/busybox32" true >> "$DBG" 2>&1; then
      mv -f "$TMPDIR/busybox32" "$BBBIN" 2>/dev/null
      ARCH="armeabi-v7a"
    fi
  fi
fi

if [ ! -x "$BBBIN" ]; then
  for a in "arm64-v8a" "armeabi-v7a" "x86_64" "x86"; do
    unzip -o "$ZIPFILE" "lib/$a/libbusybox.so" -d "$TMPDIR" >> "$DBG" 2>&1
    libpath="$TMPDIR/lib/$a/libbusybox.so"
    if [ -f "$libpath" ]; then
      chmod 755 "$libpath" 2>/dev/null
      if "$libpath" true >> "$DBG" 2>&1; then
        mv -f "$libpath" "$BBBIN" 2>/dev/null
        ARCH="$a"
        rm -rf "$TMPDIR/lib" 2>/dev/null
        break
      fi
    fi
  done
fi

if [ -n "$BBBIN" ] && [ -x "$BBBIN" ] && "$BBBIN" true >>"$DBG" 2>&1; then
  raw_print "- Busybox ready ($ARCH)"
else
  raw_print "- WARNING: busybox unavailable, using recovery built-ins"
  BBBIN=""
fi

export BBBIN
export INSTALLER
export ARCH
export ASH_STANDALONE=1
export OUTFD
export ZIPFILE

raw_print "- Extracting payload ..."
mkdir -p "$INSTALLER" 2>/dev/null

# 1. Primary: use verified busybox unzip which supports glob patterns reliably
if [ -n "$BBBIN" ] && [ -x "$BBBIN" ]; then
  "$BBBIN" unzip -o "$ZIPFILE" "assets/*" "lib/*" -d "$INSTALLER" >>"$DBG" 2>&1
fi

# 2. Fallback 1: try recovery built-in unzip with pattern if scripts are not extracted
if [ ! -f "$INSTALLER/assets/InstallMultiRoot.sh" ] && [ ! -f "$INSTALLER/assets/UninstallMultiRoot.sh" ]; then
  unzip -o "$ZIPFILE" "assets/*" "lib/*" -d "$INSTALLER" >>"$DBG" 2>&1
fi

# 3. Fallback 2: full archive extraction (works across all recoveries regardless of glob support)
if [ ! -f "$INSTALLER/assets/InstallMultiRoot.sh" ] && [ ! -f "$INSTALLER/assets/UninstallMultiRoot.sh" ]; then
  raw_print "- Retrying payload extraction ..."
  rm -rf "$INSTALLER" 2>/dev/null
  mkdir -p "$INSTALLER" 2>/dev/null
  if [ -n "$BBBIN" ] && [ -x "$BBBIN" ]; then
    "$BBBIN" unzip -o "$ZIPFILE" -d "$INSTALLER" >>"$DBG" 2>&1
  else
    unzip -o "$ZIPFILE" -d "$INSTALLER" >>"$DBG" 2>&1
  fi
  # Reclaim RAM: Manager APKs are streamed directly from $ZIPFILE by installer
  rm -f "$INSTALLER"/*.apk 2>/dev/null
fi

# 4. Fallback 3: check if archive was zipped with a parent folder
if [ ! -f "$INSTALLER/assets/InstallMultiRoot.sh" ] && [ ! -f "$INSTALLER/assets/UninstallMultiRoot.sh" ]; then
  _nested=$(find "$INSTALLER" -type f \( -name "InstallMultiRoot.sh" -o -name "UninstallMultiRoot.sh" \) 2>/dev/null | head -n 1)
  if [ -n "$_nested" ] && [ -f "$_nested" ]; then
    _nested_assets=$(dirname "$_nested")
    _nested_root=$(dirname "$_nested_assets")
    if [ "$_nested_assets" != "$INSTALLER/assets" ]; then
      mkdir -p "$INSTALLER/assets" 2>/dev/null
      cp -rf "$_nested_assets"/* "$INSTALLER/assets/" 2>/dev/null
    fi
    if [ -d "$_nested_root/lib" ] && [ "$_nested_root/lib" != "$INSTALLER/lib" ]; then
      mkdir -p "$INSTALLER/lib" 2>/dev/null
      cp -rf "$_nested_root/lib"/* "$INSTALLER/lib/" 2>/dev/null
    fi
  fi
fi

chmod -R 755 "$INSTALLER/assets" "$INSTALLER/lib" 2>/dev/null

# Pick the installer by ZIP name when possible, else default to install.
SCRIPT=""
LOWER=""
LOWER=$(echo "$ZIPFILE" | tr 'A-Z' 'a-z' 2>/dev/null)
case "$LOWER" in
  *uninstall*|*remove*)
    if [ -f "$INSTALLER/assets/UninstallMultiRoot.sh" ]; then SCRIPT="$INSTALLER/assets/UninstallMultiRoot.sh"; fi
    ;;
  *)
    if [ -f "$INSTALLER/assets/InstallMultiRoot.sh" ]; then SCRIPT="$INSTALLER/assets/InstallMultiRoot.sh"; fi
    ;;
esac
if [ -z "$SCRIPT" ]; then
  for s in "$INSTALLER/assets/InstallMultiRoot.sh" "$INSTALLER/assets/UninstallMultiRoot.sh"; do
    if [ -f "$s" ]; then SCRIPT="$s"; break; fi
  done
fi

if [ -z "$SCRIPT" ]; then
  raw_print "- ERROR: Installer script missing!"
  raw_print "- Debug: listing $INSTALLER:"
  ls -la "$INSTALLER" >> "$DBG" 2>&1
  [ -d "$INSTALLER/assets" ] && ls -la "$INSTALLER/assets" >> "$DBG" 2>&1
  exit 1
fi

raw_print "- Launching installer ..."
if [ -n "$BBBIN" ] && [ -x "$BBBIN" ]; then
  exec "$BBBIN" sh "$SCRIPT" "$@"
else
  exec sh "$SCRIPT" "$@"
fi
sh "$SCRIPT" "$@"
exit 1
