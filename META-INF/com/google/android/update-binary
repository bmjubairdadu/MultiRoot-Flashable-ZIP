#!/sbin/sh
# FolkPatch Magisk-style recovery bootstrap (POSIX sh, no bashisms)
# Args from recovery: $1 api-version, $2 fd, $3 zipfile
# Debug mode: log to /tmp/fp_debug.log so the user can send last lines.
OUTFD="$2"
ZIPFILE="$3"
TMPDIR="/dev/tmp"
BBBIN="$TMPDIR/busybox"
INSTALLER="$TMPDIR/fp_install"

DBG=""
for d in /tmp /dev/tmp /cache/recovery /data/local/tmp; do
  if [ -d "$d" ] || mkdir -p "$d" 2>/dev/null; then DBG="$d/fp_debug.log"; break; fi
done
if [ -z "$DBG" ]; then DBG="/tmp/fp_debug.log"; fi

raw_print() {
  echo "$1" >> "$DBG" 2>/dev/null
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\nui_print\n' "$1" >> "/proc/self/fd/$OUTFD" 2>/dev/null
  fi
  # also spam stderr so it shows in older recoveries
  echo "$1" >&2
}

raw_print "****************************"
raw_print " FolkPatch Recovery Installer"
raw_print " v10.3 (KP-0.13.8)"
raw_print " OUTFD=$OUTFD ZIP=$ZIPFILE"
raw_print " DBG=$DBG"
raw_print "****************************"

# Normalize TMPDIR to somewhere writable.
TMPDIR=""
for d in /tmp /dev/tmp /cache/recovery /data/local/tmp; do
  if mkdir -p "$d" 2>/dev/null && [ -d "$d" ]; then TMPDIR="$d"; break; fi
done
if [ -z "$TMPDIR" ]; then TMPDIR="/tmp"; mkdir -p "$TMPDIR" 2>/dev/null; fi
if [ -z "$DBG" ] || [ ! -d "$(dirname "$DBG" 2>/dev/null)" ]; then DBG="$TMPDIR/fp_debug.log"; fi
: > "$DBG" 2>/dev/null
raw_print "- TMPDIR=$TMPDIR"
raw_print "- args: 1=$1 2=$2 3=$3 0=$0"
ls -ld "$ZIPFILE" >> "$DBG" 2>&1
raw_print "- ls ZIP rc=$?"

BBBIN="$TMPDIR/busybox"
INSTALLER="$TMPDIR/fp_install"
rm -rf "$INSTALLER" 2>/dev/null
if [ -f "$BBBIN" ]; then : > "$BBBIN" 2>/dev/null; rm -f "$BBBIN" 2>/dev/null; fi
mkdir -p "$INSTALLER" 2>/dev/null
raw_print "- installer dir: $INSTALLER err=$?"

if [ ! -f "$ZIPFILE" ]; then
  raw_print "- Zip not found: $ZIPFILE"
  raw_print "- tip: re-download, sdcard may be unmounted"
  ls -R /sdcard 2>&1 | head -n 50 >> "$DBG" 2>&1
  exit 1
fi

# Busybox bootstrap via recovery's own busybox/unzip.
raw_print "- extracting busybox ..."
# Try built-in unzip first.
unzip -o "$ZIPFILE" "busybox" -d "$TMPDIR" >> "$DBG" 2>&1
raw_print "- unzip busybox rc=$?"
if [ -f "$TMPDIR/busybox" ]; then
  chmod 755 "$TMPDIR/busybox" 2>/dev/null
  ls -l "$TMPDIR/busybox" >> "$DBG" 2>&1
fi
if [ ! -x "$BBBIN" ]; then
  unzip -o "$ZIPFILE" "lib/arm64-v8a/libbusybox.so" -d "$TMPDIR" >> "$DBG" 2>&1
  raw_print "- unzip libbusybox rc=$?"
  if [ -f "$TMPDIR/lib/arm64-v8a/libbusybox.so" ]; then
    chmod 755 "$TMPDIR/lib/arm64-v8a/libbusybox.so" 2>/dev/null
    mv -f "$TMPDIR/lib/arm64-v8a/libbusybox.so" "$BBBIN" 2>/dev/null
    rm -rf "$TMPDIR/lib" 2>/dev/null
  fi
fi
if [ -f "$BBBIN" ]; then
  chmod 755 "$BBBIN" 2>/dev/null
  ls -l "$BBBIN" >> "$DBG" 2>&1
fi
if [ -n "$BBBIN" ] && [ -x "$BBBIN" ] && "$BBBIN" true >>"$DBG" 2>&1; then
  raw_print "- busybox ready: $BBBIN"
else
  raw_print "- WARNING: busybox unavailable, using recovery built-ins"
  BBBIN=""
fi

export BBBIN
export INSTALLER
export ASH_STANDALONE=1

raw_print "- extracting payload ..."
mkdir -p "$INSTALLER" 2>/dev/null
# Try recovery unzip; fall back to busybox unzip if present.
unzip -o "$ZIPFILE" "assets/*" "lib/*" "META-INF/com/google/*" "FolkPatch.apk" "README.txt" -d "$INSTALLER" >>"$DBG" 2>&1
URC=$?
raw_print "- unzip payload rc=$URC"
if [ -n "$BBBIN" ] && [ ! -f "$INSTALLER/assets/kpimg" ]; then
  raw_print "- retry with busybox unzip"
  rm -rf "$INSTALLER" 2>/dev/null; mkdir -p "$INSTALLER" 2>/dev/null
  "$BBBIN" unzip -o "$ZIPFILE" "assets/*" "lib/*" "META-INF/com/google/*" "FolkPatch.apk" "README.txt" -d "$INSTALLER" >>"$DBG" 2>&1
  raw_print "- bb unzip rc=$?"
fi

ls -R "$INSTALLER" 2>&1 | head -n 120 >> "$DBG" 2>&1
chmod 755 "$INSTALLER/assets/"*.sh 2>/dev/null
chmod 755 "$INSTALLER/lib/arm64-v8a/"*.so "$INSTALLER/assets/kpimg" 2>/dev/null
for f in "$INSTALLER/assets/"*.sh "$INSTALLER/lib/arm64-v8a/"*.so "$INSTALLER/assets/kpimg"; do
  ls -l "$f" >> "$DBG" 2>&1
done

# Pick the installer by ZIP name when possible, else use whichever
SCRIPT=""
LOWER=""
LOWER=$(echo "$ZIPFILE" | tr 'A-Z' 'a-z' 2>/dev/null)
raw_print "- lower ZIP: $LOWER"
case "$LOWER" in
  *uninstall*)
    if [ -f "$INSTALLER/assets/UninstallFP.sh" ]; then SCRIPT="$INSTALLER/assets/UninstallFP.sh"; fi
    ;;
  *patcher*|*patch-only*|*patch_only*)
    if [ -f "$INSTALLER/assets/PatchOnly.sh" ]; then SCRIPT="$INSTALLER/assets/PatchOnly.sh"; fi
    ;;
  *)
    if [ -f "$INSTALLER/assets/InstallFP.sh" ]; then SCRIPT="$INSTALLER/assets/InstallFP.sh"; fi
    ;;
esac
if [ -z "$SCRIPT" ]; then
  for s in "$INSTALLER/assets/InstallFP.sh" "$INSTALLER/assets/PatchOnly.sh" "$INSTALLER/assets/UninstallFP.sh"; do
    if [ -f "$s" ]; then SCRIPT="$s"; break; fi
  done
fi

if [ -z "$SCRIPT" ]; then
  raw_print "- Installer script missing!"
  raw_print "- contents in $INSTALLER/assets:"
  ls -l "$INSTALLER/assets" >> "$DBG" 2>&1
  cat "$DBG" 2>&1 | while IFS= read -r line || [ -n "$line" ]; do raw_print " DBG: $line"; done
  exit 1
fi

raw_print "- launching: $SCRIPT"
raw_print "- DBG log at: $DBG (will survive on /tmp)"
# If exec fails we keep DBG and exit 1 so recovery shows Error 1 with our msg.
# Use busybox sh when available, else system sh.
if [ -n "$BBBIN" ] && [ -x "$BBBIN" ]; then
  exec "$BBBIN" sh "$SCRIPT" "$1" "$2" "$3"
else
  exec sh "$SCRIPT" "$1" "$2" "$3"
fi
raw_print "- exec failed! trying fallback sh"
sh "$SCRIPT" "$1" "$2" "$3"
exit 1
